---
import Base from '../../layouts/Base.astro';
---
<Base current="archive" title="Archive" accent="archive"
      description="Older sciart experiments, kept with their dates attached.">
  <section class="wrap">
    <h1 class="reveal">Archive</h1>
    <p class="lead reveal">
      Earlier sciart experiments.
    </p>
    <ul class="list reveal">
      <li>
        <a href="/archive/hilma-af-klint/">
          <span class="when">2022</span>
          <span class="what">
            <strong>What would Hilma af Klint do?</strong>
            Prompting a hosted text-to-image tool toward cell biology.
          </span>
        </a>
      </li>
    </ul>
  </section>
</Base>

<style>
  section{padding:clamp(40px,8vw,80px) clamp(18px,4vw,32px) 0}
  .lead{margin-top:22px}
  .list{list-style:none;margin:48px 0 0;padding:0;border-top:1px solid var(--rule)}
  .list li{border-bottom:1px solid var(--rule)}
  .list a{
    display:grid;grid-template-columns:110px 1fr;gap:20px;padding:24px 0;
    text-decoration:none;color:var(--ink);align-items:baseline;
  }
  .list a:hover .what strong{text-decoration:underline;text-decoration-color:var(--accent)}
  .when{font-family:var(--mono);font-size:11px;letter-spacing:.11em;color:var(--muted)}
  .what{font-family:var(--serif);color:var(--muted);line-height:1.6;max-width:56ch}
  .what strong{display:block;color:var(--ink);font-weight:500;font-size:1.15rem;margin-bottom:5px}
  @media(max-width:620px){.list a{grid-template-columns:1fr;gap:8px}}
</style>
