---
const { href, kind, title, blurb, thumb, image } = Astro.props;
---
<a class="card reveal" href={href}>
  <span class="thumb">
    {image
      ? <img src={image} alt="" width="640" height="480" loading="lazy" />
      : <canvas data-thumb={thumb} aria-hidden="true"></canvas>}
  </span>
  <span class="kind">{kind}</span>
  <h3>{title}</h3>
  <p>{blurb}</p>
</a>

<style>
  .card{display:flex;flex-direction:column;gap:13px;text-decoration:none;color:inherit}
  /* The ratio lives on the wrapper, not on the image. aspect-ratio on a replaced
     element competes with its intrinsic size; on a plain box it simply holds. */
  .thumb{
    display:block;width:100%;aspect-ratio:4/3;overflow:hidden;
    background:var(--sunk);box-shadow:0 2px 22px var(--shadow);
    transition:transform .35s ease;
  }
  .thumb img,.thumb canvas{
    width:100%;height:100%;display:block;object-fit:cover;object-position:center;
  }
  .card:hover .thumb{transform:translateY(-3px)}
  .kind{
    font-family:var(--mono);font-size:10px;letter-spacing:.11em;
    text-transform:uppercase;color:var(--muted);
  }
  h3{font-family:var(--serif);font-weight:400;font-size:1.2rem;margin:0;line-height:1.3}
  p{margin:0;color:var(--muted);font-size:.92rem;line-height:1.55;max-width:40ch}
</style>
