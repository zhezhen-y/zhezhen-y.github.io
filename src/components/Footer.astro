---
const year = new Date().getFullYear();
---
<footer class="wrap">
  <p class="line">Beauty of randomness &mdash; sciart by Zhezhen Yu</p>
  <p class="line">
    <a href="https://github.com/zhezhen-y">GitHub</a>
  </p>
  <p class="line faint">&copy; {year}</p>
</footer>

<style>
  footer{
    margin-top:var(--step);padding-top:26px;padding-bottom:64px;
    border-top:1px solid var(--rule);
    display:flex;flex-wrap:wrap;gap:8px 28px;align-items:baseline;
  }
  .line{
    margin:0;font-family:var(--mono);font-size:10px;letter-spacing:.1em;
    text-transform:uppercase;color:var(--muted);
  }
  .faint{color:var(--faint);margin-left:auto}
  a{color:var(--muted);text-decoration:none}
  a:hover{color:var(--ink);text-decoration:underline}
</style>
